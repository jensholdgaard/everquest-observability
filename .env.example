# Copy to .env (git-ignored) and fill in. Consumed at deploy time; never commit the real file.

# Public domain that resolves to the server (used by Caddy for TLS and by the Discord redirect URI).
PERSES_DOMAIN=dps.example.com

# Perses session key: openssl rand -hex 16
PERSES_ENCRYPTION_KEY=

# Discord application (Developer Portal -> your app -> OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
