# Copy to .env (git-ignored) and fill in. Used by deploy/run-local.sh for local Discord-login testing.
# (For the CI/Hetzner deploy you instead set the Actions secrets + the PERSES_DOMAIN variable; the
#  workflow derives PERSES_EXTERNAL_URL/PERSES_COOKIE_SECURE itself.)

# Where Perses is reached in THIS run. Local testing uses http://localhost:8080.
PERSES_EXTERNAL_URL=http://localhost:8080
PERSES_COOKIE_SECURE=false

# Perses session key: openssl rand -hex 16
PERSES_ENCRYPTION_KEY=

# Discord application (Developer Portal -> your app -> OAuth2).
# For local testing, add this redirect to the app:
#   http://localhost:8080/api/auth/providers/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
